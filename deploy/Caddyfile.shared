{
    admin off
    auto_https off
}

http://:8080 {
    encode zstd gzip
    request_body {
        max_size 6MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
    handle_path /media/* {
        root * /srv/media
        header Content-Security-Policy "default-src 'none'; img-src 'self'"
        file_server
    }
    handle {
        reverse_proxy web:8000 {
            # Only the host HTTPS proxy may reach this loopback-published hop.
            header_up X-Forwarded-Proto https
        }
    }
}
