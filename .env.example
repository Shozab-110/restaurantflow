# Copy to .env and replace every CHANGE_ME value. Never commit .env.
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS_TOKEN_URLSAFE_60
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-restaurant.example.com
CSRF_TRUSTED_ORIGINS=https://your-restaurant.example.com
DJANGO_TIME_ZONE=Asia/Karachi
DJANGO_SECURE_SSL_REDIRECT=true
TRUST_PROXY_HEADERS=true
# Optional distinct cookie names for shared-host deployments:
# DJANGO_SESSION_COOKIE_NAME=restaurantflow_session
# DJANGO_CSRF_COOKIE_NAME=restaurantflow_csrf
POSTGRES_DB=restaurantflow
POSTGRES_USER=restaurantflow
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
# Docker Compose supplies POSTGRES_HOST=db inside the application containers.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
APP_PORT=8000
# Production initial owner: set temporarily in your shell, then unset.
# RESTAURANTFLOW_OWNER_PASSWORD=
# Demo only, with DJANGO_DEBUG=true. Never use demo accounts in production.
# RESTAURANTFLOW_DEMO_PASSWORD=
